@@ -0,0 +1,90 @@
+#ifndef GUARD_PSS_NET_H
+#define GUARD_PSS_NET_H
+
+// PSS network bridge: a fixed-layout mailbox in EWRAM that an external host
+// (emulator script, link-cable adapter firmware, etc.) reads and writes.
+// The GBA has no network hardware, so the ROM never touches a socket. It posts
+// a request into the mailbox and polls for the host's response.
+//
+// The host locates the mailbox by scanning EWRAM for PSS_MAILBOX_MAGIC.
+// Protocol reference: bridge/PROTOCOL.md
+
+#define PSS_MAILBOX_MAGIC      "PSSMBX01"
+#define PSS_MAILBOX_VERSION    1
+#define PSS_PAYLOAD_MAX        64
+
+// Frames without a host heartbeat change before the host counts as gone.
+#define PSS_HOST_TIMEOUT_FRAMES 180
+// Frames to wait for a response to a request before giving up.
+#define PSS_REQUEST_TIMEOUT_FRAMES 300
+
+// Commands (ROM -> host)
+enum PssCmd
+{
+    PSS_CMD_NONE = 0,
+    PSS_CMD_PING,         // req: empty.                  resp: empty
+    PSS_CMD_HELLO,        // req: PssHelloReq.            resp: PssHelloResp
+    PSS_CMD_PLAYER_LIST,  // req: empty.                  resp: PssPlayerListResp
+};
+
+// Response status (host -> ROM)
+enum PssStatus
+{
+    PSS_STATUS_OK = 0,
+    PSS_STATUS_ERROR,        // host understood the request and refused it
+    PSS_STATUS_UNSUPPORTED,  // unknown command
+    PSS_STATUS_OFFLINE,      // host is up but the server is unreachable
+};
+
+// Client-side request state
+enum PssRequestState
+{
+    PSS_REQ_IDLE = 0,
+    PSS_REQ_PENDING,
+    PSS_REQ_DONE,
+    PSS_REQ_TIMED_OUT,
+};
+
+#define PSS_NAME_LEN        8   // PLAYER_NAME_LENGTH (7) + terminator, GBA charmap
+#define PSS_MAX_LISTED      4
+
+struct PssHelloReq
+{
+    u8 name[PSS_NAME_LEN];       // GBA-encoded player name, 0xFF terminated
+    u8 trainerId[4];             // gSaveBlock2Ptr->playerTrainerId (little endian)
+    u8 gender;
+    u8 pad[3];
+};
+
+struct PssHelloResp
+{
+    u8 sessionId[4];
+    u8 playersOnline[2];         // little endian u16
+    u8 pad[2];
+};
+
+struct PssPlayerEntry
+{
+    u8 name[PSS_NAME_LEN];
+    u8 gender;
+    u8 pad[3];
+};
+
+struct PssPlayerListResp
+{
+    u8 count;                    // <= PSS_MAX_LISTED
+    u8 pad[3];
+    struct PssPlayerEntry players[PSS_MAX_LISTED];
+};
+
+void PssNet_Init(void);
+void PssNet_Update(void);        // call once per frame from the main loop
+bool8 PssNet_IsHostPresent(void);
+bool8 PssNet_Send(u8 cmd, const void *data, u16 len);
+u8 PssNet_GetRequestState(void);
+// Valid only when the request state is PSS_REQ_DONE. Returns the response
+// payload and writes its length/status. Marks the mailbox idle again.
+const u8 *PssNet_TakeResponse(u16 *len, u8 *status);
+void PssNet_Cancel(void);
+
+#endif // GUARD_PSS_NET_H
