@@ -0,0 +1,88 @@
+# Building and running the PSS bridge build
+
+## 1. Build the ROM (on your own machine)
+
+This repo is pret/pokefirered plus the PSS changes. Follow `INSTALL.md` to get
+devkitARM and agbcc, then:
+
+    make -j$(nproc)
+
+The output is `pokefirered.gba`. The change makes the ROM differ from the
+retail one, so `make compare` will report a mismatch; that is expected.
+Start menu -> **PSS** opens the hub screen.
+
+## 2. Choose a password
+
+Pick one shared password (at least 8 characters). It lives in exactly two kinds
+of place, and never in this repository:
+
+- on the server, as the `PSS_PASSWORD` setting, and
+- in each player's own copy of `pss_bridge.lua`, on the `local PASSWORD = ""` line.
+
+The password is never sent over the network. The server sends a random
+challenge, and the bridge answers with an HMAC-SHA256 proof computed from the
+password and that challenge. A recorded proof is useless for a later login.
+Five failed logins from one address in a minute lock that address out for five
+minutes.
+
+## 3. Run the relay server
+
+Local test (your own machine):
+
+    PSS_PASSWORD='your password' python3 bridge/relay_server.py --host 127.0.0.1 --port 7777
+
+Use single quotes in a shell so characters like `!` are not interpreted.
+
+### On a rented Linux server (Ubuntu)
+
+1. Copy `bridge/relay_server.py` to the server (`scp`), for example to `/opt/pss/`.
+2. Store the password in a file only root can read:
+
+       echo 'PSS_PASSWORD=your password' | sudo tee /etc/pss.env
+       sudo chmod 600 /etc/pss.env
+
+3. Create `/etc/systemd/system/pss.service`:
+
+       [Unit]
+       Description=PSS relay
+       After=network.target
+
+       [Service]
+       EnvironmentFile=/etc/pss.env
+       ExecStart=/usr/bin/python3 /opt/pss/relay_server.py --host 0.0.0.0 --port 7777
+       Restart=always
+       DynamicUser=yes
+       NoNewPrivileges=yes
+
+       [Install]
+       WantedBy=multi-user.target
+
+4. Start it: `sudo systemctl enable --now pss`, then check `systemctl status pss`.
+5. Open the port: `sudo ufw allow 7777/tcp` (and in the provider's firewall
+   panel, if it has one).
+
+## 4. Run the ROM with the bridge
+
+In each player's copy of `bridge/pss_bridge.lua`, set:
+
+    local SERVER_HOST = "your.server.ip.address"
+    local PASSWORD    = "the shared password"
+
+Open `pokefirered.gba` in mGBA 0.10 or newer, then Tools -> Scripting ->
+File -> Load script -> `bridge/pss_bridge.lua`. The log should print
+"mailbox found", then "connected to relay", then "logged in to the relay".
+In the game, the hub's top-right indicator shows ONLINE while the bridge is
+running. CONNECT sends your trainer name to the relay; PLAYER LIST shows others.
+
+If the log says the relay rejected the login, check the password on both
+sides. The bridge waits 60 seconds before trying again.
+
+## What is and is not protected
+
+The login keeps strangers out. Traffic after login (player names, trainer IDs)
+is not encrypted, so someone who can watch your network could read it. Do not
+put anything secret in the protocol. Wrapping the connection in TLS or SSH is
+the next step if that matters to you.
+
+See `PROTOCOL.md` for the mailbox format if you want to write a different
+host (a link-cable adapter, another emulator, etc.).
diff --git a/bridge/pss_bridge.lua b/bridge/pss_bridge.lua
new file mode 100644
index 0000000..0aa4ebe
--- /dev/null
+++ b/bridge/pss_bridge.lua
@@ -0,0 +1,329 @@
+-- PSS bridge for mGBA (scripting API, mGBA 0.10+).
+-- Load via Tools > Scripting > File > Load script, with the ROM already running.
+-- Finds the PSS mailbox in EWRAM, forwards requests to relay_server.py over TCP,
+-- and writes the replies back. See PROTOCOL.md for the mailbox layout.
+
+local SERVER_HOST = "127.0.0.1"
+local SERVER_PORT = 7777
+-- The shared password for the relay server. Type it between the quotes, on YOUR
+-- copy of this file only. Never paste it into a shared or published copy.
+local PASSWORD = ""
+
+local EWRAM_BASE = 0x02000000
+local EWRAM_SIZE = 0x40000
+local MAGIC = "PSSMBX01"
+
+-- Mailbox offsets
+local OFF_VERSION, OFF_ROMSEQ, OFF_HOSTSEQ, OFF_BEAT = 0x08, 0x0C, 0x10, 0x14
+local OFF_CMD, OFF_STATUS, OFF_REQLEN, OFF_RESPLEN = 0x18, 0x19, 0x1A, 0x1C
+local OFF_REQ, OFF_RESP = 0x20, 0x60
+local PAYLOAD_MAX = 64
+
+local CMD_PING, CMD_HELLO, CMD_PLAYER_LIST = 1, 2, 3
+local ST_OK, ST_ERROR, ST_UNSUPPORTED, ST_OFFLINE = 0, 1, 2, 3
+
+local mailbox = nil        -- absolute address once found
+local lastSeen = 0         -- last romSeq we picked up
+local pending = nil        -- { seq = n, cmd = c } while waiting for the server
+local sock = nil
+local connected = false
+local authed = false      -- true once the relay accepted our password proof
+local warnedNoPassword = false
+local recvBuf = ""
+local reconnectAt = 0
+local frame = 0
+
+local function log(msg) console:log("[PSS] " .. msg) end
+
+local function toHex(s)
+  return (s:gsub(".", function(c) return string.format("%02x", c:byte()) end))
+end
+
+local function fromHex(h)
+  return (h:gsub("%x%x", function(x) return string.char(tonumber(x, 16)) end))
+end
+
+local function le(n, bytes)
+  local out = {}
+  for i = 1, bytes do
+    out[i] = string.char(n & 0xFF)
+    n = n >> 8
+  end
+  return table.concat(out)
+end
+
+-- Pure-Lua SHA-256 and HMAC-SHA256 (Lua 5.3/5.4 integer operators). Used for the
+-- login challenge so the password is never sent over the network.
+local SHA_K = {
+  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+}
+
+local function rotr(x, n) return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF end
+
+local function sha256(msg)
+  local H = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+              0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 }
+  local len = #msg
+  msg = msg .. "\128" .. string.rep("\0", (55 - len) % 64) .. string.pack(">I8", len * 8)
+  for chunk = 1, #msg, 64 do
+    local w = {}
+    for i = 0, 15 do w[i] = string.unpack(">I4", msg, chunk + i * 4) end
+    for i = 16, 63 do
+      local s0 = rotr(w[i - 15], 7) ~ rotr(w[i - 15], 18) ~ (w[i - 15] >> 3)
+      local s1 = rotr(w[i - 2], 17) ~ rotr(w[i - 2], 19) ~ (w[i - 2] >> 10)
+      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFF
+    end
+    local a, b, c, d, e, f, g, h = table.unpack(H)
+    for i = 0, 63 do
+      local S1 = rotr(e, 6) ~ rotr(e, 11) ~ rotr(e, 25)
+      local ch = (e & f) ~ (~e & g)
+      local t1 = (h + S1 + ch + SHA_K[i + 1] + w[i]) & 0xFFFFFFFF
+      local S0 = rotr(a, 2) ~ rotr(a, 13) ~ rotr(a, 22)
+      local maj = (a & b) ~ (a & c) ~ (b & c)
+      local t2 = (S0 + maj) & 0xFFFFFFFF
+      h, g, f, e = g, f, e, (d + t1) & 0xFFFFFFFF
+      d, c, b, a = c, b, a, (t1 + t2) & 0xFFFFFFFF
+    end
+    H[1] = (H[1] + a) & 0xFFFFFFFF; H[2] = (H[2] + b) & 0xFFFFFFFF
+    H[3] = (H[3] + c) & 0xFFFFFFFF; H[4] = (H[4] + d) & 0xFFFFFFFF
+    H[5] = (H[5] + e) & 0xFFFFFFFF; H[6] = (H[6] + f) & 0xFFFFFFFF
+    H[7] = (H[7] + g) & 0xFFFFFFFF; H[8] = (H[8] + h) & 0xFFFFFFFF
+  end
+  return string.pack(">I4I4I4I4I4I4I4I4", table.unpack(H))
+end
+
+local function hmacSha256Hex(key, msg)
+  if #key > 64 then key = sha256(key) end
+  key = key .. string.rep("\0", 64 - #key)
+  local ipad, opad = {}, {}
+  for i = 1, 64 do
+    local k = key:byte(i)
+    ipad[i] = string.char(k ~ 0x36)
+    opad[i] = string.char(k ~ 0x5c)
+  end
+  local inner = sha256(table.concat(ipad) .. msg)
+  local out = sha256(table.concat(opad) .. inner)
+  return (out:gsub(".", function(c) return string.format("%02x", c:byte()) end))
+end
+
+-- Exposed only so the crypto can be checked against known test vectors.
+PssCrypto = { sha256 = sha256, hmacHex = hmacSha256Hex }
+
+local function findMailbox()
+  local data = emu:readRange(EWRAM_BASE, EWRAM_SIZE)
+  local pos = data:find(MAGIC, 1, true)
+  if not pos then return nil end
+  local addr = EWRAM_BASE + pos - 1
+  if emu:read32(addr + OFF_VERSION) ~= 1 then
+    log("mailbox version mismatch, ignoring")
+    return nil
+  end
+  return addr
+end
+
+local function mailboxStillValid()
+  local data = emu:readRange(mailbox, 8)
+  return data == MAGIC
+end
+
+-- Write a response and publish it. Dropped if the ROM has moved on.
+local function respond(seq, status, payload)
+  if emu:read32(mailbox + OFF_ROMSEQ) ~= seq then return end
+  payload = payload or ""
+  if #payload > PAYLOAD_MAX then payload = payload:sub(1, PAYLOAD_MAX) end
+  for i = 1, #payload do
+    emu:write8(mailbox + OFF_RESP + i - 1, payload:byte(i))
+  end
+  emu:write16(mailbox + OFF_RESPLEN, #payload)
+  emu:write8(mailbox + OFF_STATUS, status)
+  emu:write32(mailbox + OFF_HOSTSEQ, seq) -- published last
+end
+
+local function connectServer()
+  if PASSWORD == "" then
+    reconnectAt = frame + 600
+    if not warnedNoPassword then
+      warnedNoPassword = true
+      log("no PASSWORD set at the top of pss_bridge.lua; not connecting to the relay")
+    end
+    return
+  end
+  sock = socket.tcp()
+  local ok = sock:connect(SERVER_HOST, SERVER_PORT)
+  if ok then
+    connected = true
+    authed = false
+    recvBuf = ""
+    log("connected to relay " .. SERVER_HOST .. ":" .. SERVER_PORT)
+  else
+    connected = false
+    sock = nil
+    reconnectAt = frame + 300 -- retry in ~5 seconds
+  end
+end
+
+local function dropServer(retryFrames)
+  if sock then sock:close() end
+  sock, connected, authed, recvBuf = nil, false, false, ""
+  reconnectAt = frame + (retryFrames or 300)
+  if pending then
+    respond(pending.seq, ST_OFFLINE, "")
+    pending = nil
+  end
+end
+
+local function sendLine(line)
+  local ok = sock and sock:send(line .. "\n")
+  if not ok then dropServer() return false end
+  return true
+end
+
+-- Turn a server reply line into a mailbox response for the pending request.
+local function handleReply(line)
+  if not pending then return end
+  local seq, cmd = pending.seq, pending.cmd
+  pending = nil
+
+  if line:sub(1, 3) ~= "OK " then
+    respond(seq, ST_ERROR, "")
+    return
+  end
+
+  if cmd == CMD_HELLO then
+    local sid, online = line:match("^OK HELLO (%d+) (%d+)$")
+    if not sid then respond(seq, ST_ERROR, "") return end
+    respond(seq, ST_OK, le(tonumber(sid), 4) .. le(tonumber(online), 2) .. "\0\0")
+  elseif cmd == CMD_PLAYER_LIST then
+    local count = tonumber(line:match("^OK PLAYERS (%d+)"))
+    if not count then respond(seq, ST_ERROR, "") return end
+    if count > 4 then count = 4 end
+    local out = { string.char(count), "\0\0\0" }
+    local n = 0
+    for name, gender in line:gmatch("(%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x):([01])") do
+      if n >= count then break end
+      out[#out + 1] = fromHex(name) .. string.char(tonumber(gender)) .. "\0\0\0"
+      n = n + 1
+    end
+    -- Fewer entries than announced: report what we actually have.
+    out[1] = string.char(n)
+    respond(seq, ST_OK, table.concat(out))
+  else
+    respond(seq, ST_UNSUPPORTED, "")
+  end
+end
+
+-- Login messages come first, then ordinary replies.
+local function handleLine(line)
+  local nonce = line:match("^CHALLENGE (%x+)$")
+  if nonce then
+    sendLine("AUTH " .. hmacSha256Hex(PASSWORD, nonce))
+    return
+  end
+  if not authed then
+    if line == "OK AUTH" then
+      authed = true
+      log("logged in to the relay")
+    else
+      -- ERR auth / ERR refused. Wait a long time before retrying: the server
+      -- locks out addresses that fail several times in a minute.
+      log("relay rejected the login (" .. line .. "); check PASSWORD. Retrying in 60 seconds")
+      dropServer(3600)
+    end
+    return
+  end
+  handleReply(line)
+end
+
+local function pollServer()
+  if not connected then return end
+  local chunk, err = sock:receive(512)
+  if chunk then
+    recvBuf = recvBuf .. chunk
+    if #recvBuf > 4096 then dropServer() return end
+    while true do
+      local nl = recvBuf:find("\n", 1, true)
+      if not nl then break end
+      local line = recvBuf:sub(1, nl - 1)
+      recvBuf = recvBuf:sub(nl + 1)
+      handleLine(line)
+      if not connected then return end
+    end
+  elseif err and err ~= socket.ERRORS.AGAIN and err ~= "timeout" then
+    log("relay connection lost")
+    dropServer()
+  end
+end
+
+local function pickUpRequest()
+  local romSeq = emu:read32(mailbox + OFF_ROMSEQ)
+  if romSeq == lastSeen then return end
+  lastSeen = romSeq
+  if emu:read32(mailbox + OFF_HOSTSEQ) == romSeq then return end
+
+  local cmd = emu:read8(mailbox + OFF_CMD)
+  local reqLen = emu:read16(mailbox + OFF_REQLEN)
+  if reqLen > PAYLOAD_MAX then respond(romSeq, ST_ERROR, "") return end
+  local req = reqLen > 0 and emu:readRange(mailbox + OFF_REQ, reqLen) or ""
+
+  -- A newer request supersedes any older one still in flight.
+  pending = nil
+
+  if cmd == CMD_PING then
+    respond(romSeq, ST_OK, "")
+    return
+  end
+
+  if not (connected and authed) then respond(romSeq, ST_OFFLINE, "") return end
+
+  if cmd == CMD_HELLO then
+    if #req < 13 then respond(romSeq, ST_ERROR, "") return end
+    local name = toHex(req:sub(1, 8))
+    local tid = toHex(req:sub(9, 12))
+    local gender = req:byte(13) == 1 and 1 or 0
+    pending = { seq = romSeq, cmd = cmd }
+    sendLine(string.format("HELLO %s %s %d", name, tid, gender))
+  elseif cmd == CMD_PLAYER_LIST then
+    pending = { seq = romSeq, cmd = cmd }
+    sendLine("PLAYERS")
+  else
+    respond(romSeq, ST_UNSUPPORTED, "")
+  end
+end
+
+local function onFrame()
+  frame = frame + 1
+
+  if not mailbox then
+    if frame % 60 == 0 then
+      mailbox = findMailbox()
+      if mailbox then
+        lastSeen = emu:read32(mailbox + OFF_ROMSEQ)
+        log(string.format("mailbox found at 0x%08X", mailbox))
+      end
+    end
+    return
+  end
+
+  -- Soft reset or a different ROM: the mailbox vanished, search again.
+  if frame % 120 == 0 and not mailboxStillValid() then
+    log("mailbox lost, searching again")
+    mailbox, pending = nil, nil
+    return
+  end
+
+  emu:write32(mailbox + OFF_BEAT, (emu:read32(mailbox + OFF_BEAT) + 1) & 0xFFFFFFFF)
+
+  if not connected and frame >= reconnectAt then connectServer() end
+  pollServer()
+  pickUpRequest()
+end
+
+callbacks:add("frame", onFrame)
+log("bridge loaded; waiting for the ROM's mailbox")
diff --git a/bridge/relay_server.py b/bridge/relay_server.py
