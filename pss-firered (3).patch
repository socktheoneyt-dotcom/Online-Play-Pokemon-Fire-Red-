@@ -0,0 +1,531 @@
+#include "global.h"
+#include "gflib.h"
+#include "task.h"
+#include "new_menu_helpers.h"
+#include "scanline_effect.h"
+#include "m4a.h"
+#include "menu.h"
+#include "overworld.h"
+#include "string_util.h"
+#include "strings.h"
+#include "pss_net.h"
+#include "pss_hub.h"
+#include "constants/songs.h"
+
+// Player Search System hub. The layout borrows the blue background of the
+// wireless communication status screen, so no new graphics are needed.
+
+enum {
+    COLOR_NORMAL,
+    COLOR_SELECTED,
+    COLOR_TITLE,
+    COLOR_ONLINE,
+    COLOR_OFFLINE,
+};
+
+enum {
+    WIN_TITLE,
+    WIN_MENU,
+    WIN_INFO,
+};
+
+enum {
+    MENU_CONNECT,
+    MENU_PLAYER_LIST,
+    MENU_EXIT,
+    NUM_MENU_ITEMS
+};
+
+enum {
+    STATE_INIT,
+    STATE_FADE_IN,
+    STATE_WAIT_FADE_IN,
+    STATE_INPUT,
+    STATE_WAIT_RESPONSE,
+    STATE_FADE_OUT,
+    STATE_EXIT,
+};
+
+static struct
+{
+    u8 taskId;
+    u8 cursor;
+    u8 pendingCmd;
+    u8 hostWasPresent;
+} *sHub;
+
+static const u16 sPalette[] = INCBIN_U16("graphics/wireless_status_screen/default.gbapal");
+static const u32 sBgTiles_Gfx[] = INCBIN_U32("graphics/wireless_status_screen/bg.4bpp.lz");
+static const u16 sBgTiles_Tilemap[] = INCBIN_U16("graphics/wireless_status_screen/bg.bin");
+
+static const struct BgTemplate sBgTemplates[] = {
+    {
+        .bg = 0,
+        .charBaseIndex = 2,
+        .mapBaseIndex = 31,
+        .screenSize = 0,
+        .paletteMode = 0,
+        .priority = 0,
+        .baseTile = 0x000
+    }, {
+        .bg = 1,
+        .charBaseIndex = 0,
+        .mapBaseIndex =  8,
+        .screenSize = 0,
+        .paletteMode = 0,
+        .priority = 1,
+        .baseTile = 0x000
+    }
+};
+
+static const struct WindowTemplate sWindowTemplates[] = {
+    [WIN_TITLE] = {
+        .bg = 0,
+        .tilemapLeft = 3,
+        .tilemapTop = 0,
+        .width = 24,
+        .height = 3,
+        .paletteNum = 15,
+        .baseBlock = 0x001
+    },
+    [WIN_MENU] = {
+        .bg = 0,
+        .tilemapLeft = 3,
+        .tilemapTop = 4,
+        .width = 22,
+        .height = 6,
+        .paletteNum = 15,
+        .baseBlock = 0x049
+    },
+    [WIN_INFO] = {
+        .bg = 0,
+        .tilemapLeft = 3,
+        .tilemapTop = 10,
+        .width = 24,
+        .height = 9,
+        .paletteNum = 15,
+        .baseBlock = 0x0CD
+    },
+    DUMMY_WIN_TEMPLATE
+};
+
+static const u8 sText_Title[] = _("PLAYER SEARCH SYSTEM");
+static const u8 sText_Online[] = _("ONLINE");
+static const u8 sText_Offline[] = _("OFFLINE");
+static const u8 sText_Connect[] = _("CONNECT");
+static const u8 sText_PlayerList[] = _("PLAYER LIST");
+static const u8 sText_Exit[] = _("EXIT");
+static const u8 sText_Idle[] = _("Choose CONNECT to reach the\nPSS network.");
+static const u8 sText_NoHost[] = _("No network bridge found.\nStart the bridge and try\nagain.");
+static const u8 sText_Contacting[] = _("Contacting the server...\nPress B to cancel.");
+static const u8 sText_TimedOut[] = _("The server did not answer.\nTry again in a moment.");
+static const u8 sText_Refused[] = _("The server refused the\nrequest.");
+static const u8 sText_ServerDown[] = _("The bridge is running but\nthe server is unreachable.");
+static const u8 sText_BadReply[] = _("Received an invalid reply.");
+static const u8 sText_NobodyOnline[] = _("Nobody else is online\nright now.");
+static const u8 sText_PlayersOnline[] = _(" player(s) online.");
+static const u8 sText_PlayersListed[] = _("Players nearby:\n");
+static const u8 sText_Connected[] = _("Connected! ");
+static const u8 sText_NewLine[] = _("\n");
+
+static const u8 *const sMenuTexts[NUM_MENU_ITEMS] = {
+    [MENU_CONNECT]     = sText_Connect,
+    [MENU_PLAYER_LIST] = sText_PlayerList,
+    [MENU_EXIT]        = sText_Exit,
+};
+
+static void CB2_InitPssHub(void);
+static void CB2_RunPssHub(void);
+static void VBlankCB_PssHub(void);
+static void Task_PssHub(u8 taskId);
+static void ExitPssHub(void);
+
+static void AddText(u8 windowId, const u8 *str, u8 x, u8 y, u8 mode)
+{
+    u8 textColor[3];
+
+    textColor[0] = TEXT_COLOR_TRANSPARENT;
+    switch (mode)
+    {
+    default:
+    case COLOR_NORMAL:
+        textColor[1] = TEXT_COLOR_WHITE;
+        textColor[2] = TEXT_COLOR_LIGHT_GRAY;
+        break;
+    case COLOR_SELECTED:
+        textColor[1] = TEXT_COLOR_RED;
+        textColor[2] = TEXT_COLOR_LIGHT_RED;
+        break;
+    case COLOR_TITLE:
+        textColor[1] = TEXT_COLOR_LIGHT_GREEN;
+        textColor[2] = TEXT_COLOR_GREEN;
+        break;
+    case COLOR_ONLINE:
+        textColor[1] = TEXT_COLOR_LIGHT_GREEN;
+        textColor[2] = TEXT_COLOR_GREEN;
+        break;
+    case COLOR_OFFLINE:
+        textColor[1] = TEXT_COLOR_RED;
+        textColor[2] = TEXT_COLOR_LIGHT_RED;
+        break;
+    }
+    AddTextPrinterParameterized4(windowId, FONT_NORMAL_COPY_2, x, y, 1, 0, textColor, TEXT_SKIP_DRAW, str);
+}
+
+static void PrintTitle(void)
+{
+    const u8 *status;
+    u8 mode;
+    u32 width;
+
+    FillWindowPixelBuffer(WIN_TITLE, PIXEL_FILL(0));
+    AddText(WIN_TITLE, sText_Title, 4, 6, COLOR_TITLE);
+
+    if (PssNet_IsHostPresent())
+    {
+        status = sText_Online;
+        mode = COLOR_ONLINE;
+    }
+    else
+    {
+        status = sText_Offline;
+        mode = COLOR_OFFLINE;
+    }
+    width = GetStringWidth(FONT_NORMAL_COPY_2, status, 0);
+    AddText(WIN_TITLE, status, 188 - width, 6, mode);
+
+    PutWindowTilemap(WIN_TITLE);
+    CopyWindowToVram(WIN_TITLE, COPYWIN_FULL);
+}
+
+static void PrintMenu(void)
+{
+    s32 i;
+
+    FillWindowPixelBuffer(WIN_MENU, PIXEL_FILL(0));
+    for (i = 0; i < NUM_MENU_ITEMS; i++)
+        AddText(WIN_MENU, sMenuTexts[i], 4, 16 * i + 2, i == sHub->cursor ? COLOR_SELECTED : COLOR_NORMAL);
+
+    PutWindowTilemap(WIN_MENU);
+    CopyWindowToVram(WIN_MENU, COPYWIN_FULL);
+}
+
+static void PrintInfo(const u8 *str)
+{
+    FillWindowPixelBuffer(WIN_INFO, PIXEL_FILL(0));
+    AddText(WIN_INFO, str, 4, 2, COLOR_NORMAL);
+    PutWindowTilemap(WIN_INFO);
+    CopyWindowToVram(WIN_INFO, COPYWIN_FULL);
+}
+
+// Names arrive from the network and must not be trusted: stop at the first
+// terminator, and replace anything in the control-code range with '?'.
+static void CopySanitizedName(u8 *dst, const u8 *src)
+{
+    s32 i;
+
+    for (i = 0; i < PLAYER_NAME_LENGTH; i++)
+    {
+        u8 c = src[i];
+
+        if (c == EOS)
+            break;
+        if (c >= 0xF0)
+            c = CHAR_QUESTION_MARK;
+        dst[i] = c;
+    }
+    dst[i] = EOS;
+}
+
+static void SendHello(void)
+{
+    struct PssHelloReq req;
+    s32 i;
+
+    memset(&req, 0, sizeof(req));
+    for (i = 0; i < PLAYER_NAME_LENGTH + 1; i++)
+        req.name[i] = gSaveBlock2Ptr->playerName[i];
+    for (i = 0; i < TRAINER_ID_LENGTH; i++)
+        req.trainerId[i] = gSaveBlock2Ptr->playerTrainerId[i];
+    req.gender = gSaveBlock2Ptr->playerGender;
+    PssNet_Send(PSS_CMD_HELLO, &req, sizeof(req));
+}
+
+static void StartRequest(u8 cmd)
+{
+    if (!PssNet_IsHostPresent())
+    {
+        PrintInfo(sText_NoHost);
+        return;
+    }
+
+    if (cmd == PSS_CMD_HELLO)
+        SendHello();
+    else
+        PssNet_Send(cmd, NULL, 0);
+
+    sHub->pendingCmd = cmd;
+    PrintInfo(sText_Contacting);
+}
+
+static void ShowHelloResult(const u8 *data, u16 len)
+{
+    const struct PssHelloResp *resp = (const struct PssHelloResp *)data;
+    u16 online;
+
+    if (len < sizeof(*resp))
+    {
+        PrintInfo(sText_BadReply);
+        return;
+    }
+
+    online = resp->playersOnline[0] | (resp->playersOnline[1] << 8);
+    StringCopy(gStringVar4, sText_Connected);
+    ConvertIntToDecimalStringN(gStringVar1, online, STR_CONV_MODE_LEFT_ALIGN, 4);
+    StringAppend(gStringVar4, gStringVar1);
+    StringAppend(gStringVar4, sText_PlayersOnline);
+    PrintInfo(gStringVar4);
+}
+
+static void ShowPlayerListResult(const u8 *data, u16 len)
+{
+    const struct PssPlayerListResp *resp = (const struct PssPlayerListResp *)data;
+    s32 i;
+    u8 count;
+
+    // The host sends only as many entries as there are players, so the reply
+    // may be shorter than the full struct. Never read past what arrived.
+    if (len < offsetof(struct PssPlayerListResp, players))
+    {
+        PrintInfo(sText_BadReply);
+        return;
+    }
+
+    count = resp->count;
+    if (count > PSS_MAX_LISTED)
+        count = PSS_MAX_LISTED;
+    if (count > (len - offsetof(struct PssPlayerListResp, players)) / sizeof(struct PssPlayerEntry))
+        count = (len - offsetof(struct PssPlayerListResp, players)) / sizeof(struct PssPlayerEntry);
+    if (count == 0)
+    {
+        PrintInfo(sText_NobodyOnline);
+        return;
+    }
+
+    StringCopy(gStringVar4, sText_PlayersListed);
+    for (i = 0; i < count; i++)
+    {
+        CopySanitizedName(gStringVar1, resp->players[i].name);
+        StringAppend(gStringVar4, gStringVar1);
+        StringAppend(gStringVar4, sText_NewLine);
+    }
+    PrintInfo(gStringVar4);
+}
+
+static void HandleResponse(void)
+{
+    u16 len;
+    u8 status;
+    const u8 *data = PssNet_TakeResponse(&len, &status);
+
+    switch (status)
+    {
+    case PSS_STATUS_OK:
+        break;
+    case PSS_STATUS_OFFLINE:
+        PrintInfo(sText_ServerDown);
+        return;
+    default:
+        PrintInfo(sText_Refused);
+        return;
+    }
+
+    switch (sHub->pendingCmd)
+    {
+    case PSS_CMD_HELLO:
+        ShowHelloResult(data, len);
+        break;
+    case PSS_CMD_PLAYER_LIST:
+        ShowPlayerListResult(data, len);
+        break;
+    default:
+        PrintInfo(sText_BadReply);
+        break;
+    }
+}
+
+static void Task_PssHub(u8 taskId)
+{
+    s16 *data = gTasks[taskId].data;
+
+    switch (data[0])
+    {
+    case STATE_INIT:
+        PrintTitle();
+        PrintMenu();
+        PrintInfo(sText_Idle);
+        data[0]++;
+        break;
+    case STATE_FADE_IN:
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        ShowBg(1);
+        CopyBgTilemapBufferToVram(0);
+        ShowBg(0);
+        data[0]++;
+        break;
+    case STATE_WAIT_FADE_IN:
+        if (!gPaletteFade.active)
+            data[0] = STATE_INPUT;
+        break;
+    case STATE_INPUT:
+        if (PssNet_IsHostPresent() != sHub->hostWasPresent)
+        {
+            sHub->hostWasPresent = PssNet_IsHostPresent();
+            PrintTitle();
+        }
+
+        if (JOY_NEW(DPAD_UP) && sHub->cursor > 0)
+        {
+            sHub->cursor--;
+            PlaySE(SE_SELECT);
+            PrintMenu();
+        }
+        else if (JOY_NEW(DPAD_DOWN) && sHub->cursor < NUM_MENU_ITEMS - 1)
+        {
+            sHub->cursor++;
+            PlaySE(SE_SELECT);
+            PrintMenu();
+        }
+        else if (JOY_NEW(A_BUTTON))
+        {
+            PlaySE(SE_SELECT);
+            switch (sHub->cursor)
+            {
+            case MENU_CONNECT:
+                StartRequest(PSS_CMD_HELLO);
+                break;
+            case MENU_PLAYER_LIST:
+                StartRequest(PSS_CMD_PLAYER_LIST);
+                break;
+            case MENU_EXIT:
+                data[0] = STATE_FADE_OUT;
+                break;
+            }
+            if (PssNet_GetRequestState() == PSS_REQ_PENDING)
+                data[0] = STATE_WAIT_RESPONSE;
+        }
+        else if (JOY_NEW(B_BUTTON))
+        {
+            PlaySE(SE_SELECT);
+            data[0] = STATE_FADE_OUT;
+        }
+        break;
+    case STATE_WAIT_RESPONSE:
+        switch (PssNet_GetRequestState())
+        {
+        case PSS_REQ_DONE:
+            HandleResponse();
+            data[0] = STATE_INPUT;
+            break;
+        case PSS_REQ_TIMED_OUT:
+            PssNet_Cancel();
+            PrintInfo(sText_TimedOut);
+            data[0] = STATE_INPUT;
+            break;
+        default:
+            if (JOY_NEW(B_BUTTON))
+            {
+                PlaySE(SE_SELECT);
+                PssNet_Cancel();
+                PrintInfo(sText_Idle);
+                data[0] = STATE_INPUT;
+            }
+            break;
+        }
+        break;
+    case STATE_FADE_OUT:
+        PssNet_Cancel();
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+        data[0] = STATE_EXIT;
+        break;
+    case STATE_EXIT:
+        if (!gPaletteFade.active)
+        {
+            ExitPssHub();
+            DestroyTask(taskId);
+        }
+        break;
+    }
+}
+
+static void CB2_RunPssHub(void)
+{
+    if (!IsDma3ManagerBusyWithBgCopy())
+    {
+        RunTasks();
+        RunTextPrinters();
+        AnimateSprites();
+        BuildOamBuffer();
+        UpdatePaletteFade();
+    }
+}
+
+static void VBlankCB_PssHub(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+void CB2_ShowPssHub(void)
+{
+    SetMainCallback2(CB2_InitPssHub);
+}
+
+static void CB2_InitPssHub(void)
+{
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    sHub = AllocZeroed(sizeof(*sHub));
+    SetVBlankCallback(NULL);
+    ResetBgsAndClearDma3BusyFlags(FALSE);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    SetBgTilemapBuffer(1, Alloc(BG_SCREEN_SIZE));
+    SetBgTilemapBuffer(0, Alloc(BG_SCREEN_SIZE));
+    DecompressAndLoadBgGfxUsingHeap(1, sBgTiles_Gfx, 0, 0, 0);
+    CopyToBgTilemapBuffer(1, sBgTiles_Tilemap, 0, 0);
+    InitWindows(sWindowTemplates);
+    DeactivateAllTextPrinters();
+    ResetPaletteFade();
+    ResetSpriteData();
+    ResetTasks();
+    ScanlineEffect_Stop();
+    m4aSoundVSyncOn();
+    SetVBlankCallback(VBlankCB_PssHub);
+    sHub->hostWasPresent = PssNet_IsHostPresent();
+    sHub->taskId = CreateTask(Task_PssHub, 0);
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    ChangeBgX(1, 0, BG_COORD_SET);
+    ChangeBgY(1, 0, BG_COORD_SET);
+    LoadPalette(sPalette, BG_PLTT_ID(0), PLTT_SIZE_4BPP);
+    Menu_LoadStdPalAt(BG_PLTT_ID(15));
+    FillBgTilemapBufferRect(0, 0x000, 0, 0, 32, 32, 15);
+    CopyBgTilemapBufferToVram(1);
+    SetMainCallback2(CB2_RunPssHub);
+    RunTasks();
+    RunTextPrinters();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void ExitPssHub(void)
+{
+    s32 i;
+
+    FreeAllWindowBuffers();
+    for (i = 0; i < (int)ARRAY_COUNT(sBgTemplates); i++)
+        Free(GetBgTilemapBuffer(i));
+    Free(sHub);
+    SetMainCallback2(gMain.savedCallback);
+}
diff --git a/src/pss_net.c b/src/pss_net.c
new file mode 100644
index 0000000..98be267
--- /dev/null
+++ b/src/pss_net.c
@@ -0,0 +1,137 @@
+#include "global.h"
+#include "pss_net.h"
+
+// Layout is part of the host protocol. Keep it 4-byte aligned and do not
+// reorder fields without bumping PSS_MAILBOX_VERSION and updating
+// bridge/PROTOCOL.md and bridge/pss_bridge.lua.
+struct PssMailbox
+{
+    /* 0x00 */ u8 magic[8];
+    /* 0x08 */ u32 version;
+    /* 0x0C */ u32 romSeq;     // ROM increments after a request is fully written
+    /* 0x10 */ u32 hostSeq;    // host writes the romSeq value it answered, after writing the response
+    /* 0x14 */ u32 hostBeat;   // host increments this regularly while it is alive
+    /* 0x18 */ u8 cmd;
+    /* 0x19 */ u8 status;      // host -> ROM, valid when hostSeq == romSeq
+    /* 0x1A */ u16 reqLen;
+    /* 0x1C */ u16 respLen;    // host -> ROM
+    /* 0x1E */ u16 pad;
+    /* 0x20 */ u8 req[PSS_PAYLOAD_MAX];
+    /* 0x60 */ u8 resp[PSS_PAYLOAD_MAX];
+    // total 0xA0
+};
+
+static EWRAM_DATA volatile struct PssMailbox sMailbox = {};
+static EWRAM_DATA u32 sLastBeat = 0;
+static EWRAM_DATA u16 sFramesSinceBeat = 0;
+static EWRAM_DATA u16 sRequestFrames = 0;
+static EWRAM_DATA u8 sRequestState = PSS_REQ_IDLE;
+static EWRAM_DATA u8 sHostPresent = FALSE;
+static EWRAM_DATA u8 sRespBuf[PSS_PAYLOAD_MAX] = {};
+
+void PssNet_Init(void)
+{
+    static const u8 magic[8] = PSS_MAILBOX_MAGIC;
+    u32 i;
+
+    // EWRAM_DATA is not loaded from the ROM, so everything is set at runtime.
+    for (i = 0; i < sizeof(sMailbox); i++)
+        ((volatile u8 *)&sMailbox)[i] = 0;
+    for (i = 0; i < 8; i++)
+        sMailbox.magic[i] = magic[i];
+    sMailbox.version = PSS_MAILBOX_VERSION;
+
+    sLastBeat = 0;
+    sFramesSinceBeat = PSS_HOST_TIMEOUT_FRAMES;
+    sRequestFrames = 0;
+    sRequestState = PSS_REQ_IDLE;
+    sHostPresent = FALSE;
+}
+
+void PssNet_Update(void)
+{
+    u32 beat = sMailbox.hostBeat;
+
+    if (beat != sLastBeat)
+    {
+        sLastBeat = beat;
+        sFramesSinceBeat = 0;
+        sHostPresent = TRUE;
+    }
+    else if (sFramesSinceBeat < PSS_HOST_TIMEOUT_FRAMES)
+    {
+        sFramesSinceBeat++;
+    }
+    else
+    {
+        sHostPresent = FALSE;
+    }
+
+    if (sRequestState == PSS_REQ_PENDING)
+    {
+        if (sMailbox.hostSeq == sMailbox.romSeq)
+        {
+            sRequestState = PSS_REQ_DONE;
+        }
+        else if (++sRequestFrames >= PSS_REQUEST_TIMEOUT_FRAMES)
+        {
+            sRequestState = PSS_REQ_TIMED_OUT;
+        }
+    }
+}
+
+bool8 PssNet_IsHostPresent(void)
+{
+    return sHostPresent;
+}
+
+bool8 PssNet_Send(u8 cmd, const void *data, u16 len)
+{
+    u32 i;
+    const u8 *src = data;
+
+    if (sRequestState == PSS_REQ_PENDING || len > PSS_PAYLOAD_MAX)
+        return FALSE;
+
+    for (i = 0; i < len; i++)
+        sMailbox.req[i] = src[i];
+    sMailbox.cmd = cmd;
+    sMailbox.reqLen = len;
+    sMailbox.status = PSS_STATUS_OK;
+    sMailbox.respLen = 0;
+
+    sRequestFrames = 0;
+    sRequestState = PSS_REQ_PENDING;
+    // Incrementing romSeq last publishes the request to the host.
+    sMailbox.romSeq++;
+    return TRUE;
+}
+
+u8 PssNet_GetRequestState(void)
+{
+    return sRequestState;
+}
+
+const u8 *PssNet_TakeResponse(u16 *len, u8 *status)
+{
+    u16 respLen = sMailbox.respLen;
+    u32 i;
+
+    if (respLen > PSS_PAYLOAD_MAX)
+        respLen = PSS_PAYLOAD_MAX;
+    for (i = 0; i < respLen; i++)
+        sRespBuf[i] = sMailbox.resp[i];
+
+    *len = respLen;
+    *status = sMailbox.status;
+    sRequestState = PSS_REQ_IDLE;
+    return sRespBuf;
+}
+
+void PssNet_Cancel(void)
+{
+    // A late response to a cancelled or timed-out request is harmless: the next
+    // PssNet_Send bumps romSeq, so hostSeq no longer matches until the host
+    // answers the new request.
+    sRequestState = PSS_REQ_IDLE;
+}
