index 0000000..f75ce15
--- /dev/null
+++ b/bridge/relay_server.py
@@ -0,0 +1,221 @@
+#!/usr/bin/env python3
+"""PSS relay server (reference implementation) with password login.
+
+Line-based text protocol over TCP, one request per line, one reply per line.
+
+Login (first thing on every connection):
+  server -> CHALLENGE <32 hex chars, random>
+  client -> AUTH <hex HMAC-SHA256(key=password, message=the 32 hex chars as ASCII)>
+  server -> OK AUTH          (or ERR auth and the connection is closed)
+The password itself is never sent over the network.
+
+After login:
+  HELLO <name:16 hex> <trainer id:8 hex> <gender:0|1>
+      -> OK HELLO <session id> <players online>
+  PLAYERS
+      -> OK PLAYERS <count> [<name:16 hex>:<gender> ...]      (others only, max 4)
+  anything else
+      -> ERR <reason>
+
+The password is read from the PSS_PASSWORD environment variable, or from a file
+with --password-file. It is deliberately not a command-line argument (those show
+up in process listings) and is never written into this repository.
+
+Note: login proves who may join, but the traffic after login is not encrypted.
+For private data you would put this behind a TLS tunnel or SSH.
+
+Run:  PSS_PASSWORD='your password' python3 relay_server.py --host 0.0.0.0 --port 7777
+"""
+import argparse
+import asyncio
+import hashlib
+import hmac
+import os
+import random
+import re
+import secrets
+import sys
+import time
+
+MAX_LINE = 256
+MAX_LISTED = 4
+MIN_INTERVAL = 0.1       # seconds between requests per connection
+AUTH_TIMEOUT = 10.0      # seconds to answer the challenge
+MAX_CONNECTIONS = 64
+MAX_PER_IP = 4
+MAX_FAILURES = 5         # failed logins from one IP ...
+FAILURE_WINDOW = 60.0    # ... within this many seconds ...
+BLOCK_SECONDS = 300.0    # ... blocks that IP for this long
+MIN_PASSWORD_LEN = 8
+
+HEX16 = re.compile(r"^[0-9a-fA-F]{16}$")
+HEX8 = re.compile(r"^[0-9a-fA-F]{8}$")
+HEX64 = re.compile(r"^[0-9a-fA-F]{64}$")
+
+players = {}        # session id -> {"name": hex, "gender": int}
+conns_per_ip = {}   # ip -> open connection count
+failures = {}       # ip -> list of failure timestamps
+blocked_until = {}  # ip -> monotonic time
+
+
+def expected_proof(password: bytes, nonce_hex: str) -> str:
+    return hmac.new(password, nonce_hex.encode("ascii"), hashlib.sha256).hexdigest()
+
+
+def handle_line(session, line):
+    parts = line.split()
+    if not parts:
+        return "ERR empty"
+    op = parts[0].upper()
+
+    if op == "HELLO":
+        if len(parts) != 4 or not HEX16.match(parts[1]) or not HEX8.match(parts[2]) \
+                or parts[3] not in ("0", "1"):
+            return "ERR bad hello"
+        players[session] = {"name": parts[1].lower(), "gender": int(parts[3])}
+        return f"OK HELLO {session} {len(players)}"
+
+    if op == "PLAYERS":
+        if session not in players:
+            return "ERR not connected"
+        others = [p for sid, p in players.items() if sid != session][:MAX_LISTED]
+        entries = " ".join(f"{p['name']}:{p['gender']}" for p in others)
+        return f"OK PLAYERS {len(others)}" + (f" {entries}" if entries else "")
+
+    return "ERR unknown op"
+
+
+def is_blocked(ip):
+    until = blocked_until.get(ip)
+    if until is None:
+        return False
+    if time.monotonic() >= until:
+        del blocked_until[ip]
+        failures.pop(ip, None)
+        return False
+    return True
+
+
+def record_failure(ip):
+    now = time.monotonic()
+    recent = [t for t in failures.get(ip, []) if now - t < FAILURE_WINDOW]
+    recent.append(now)
+    failures[ip] = recent
+    if len(recent) >= MAX_FAILURES:
+        blocked_until[ip] = now + BLOCK_SECONDS
+        print(f"! blocking {ip} for {int(BLOCK_SECONDS)}s after repeated failed logins")
+
+
+async def authenticate(reader, writer, password, ip):
+    nonce = secrets.token_hex(16)
+    writer.write(f"CHALLENGE {nonce}\n".encode("ascii"))
+    await writer.drain()
+    try:
+        raw = await asyncio.wait_for(reader.readuntil(b"\n"), AUTH_TIMEOUT)
+    except (asyncio.TimeoutError, asyncio.IncompleteReadError, asyncio.LimitOverrunError):
+        record_failure(ip)
+        return False
+    parts = raw.decode("ascii", "replace").split()
+    ok = (len(parts) == 2 and parts[0].upper() == "AUTH" and HEX64.match(parts[1]) is not None
+          and hmac.compare_digest(parts[1].lower(), expected_proof(password, nonce)))
+    if not ok:
+        record_failure(ip)
+        writer.write(b"ERR auth\n")
+        await writer.drain()
+        return False
+    writer.write(b"OK AUTH\n")
+    await writer.drain()
+    return True
+
+
+def make_client_handler(password):
+    async def client(reader, writer):
+        peer = writer.get_extra_info("peername") or ("?", 0)
+        ip = peer[0]
+        session = None
+        counted = False
+        try:
+            if is_blocked(ip) or sum(conns_per_ip.values()) >= MAX_CONNECTIONS \
+                    or conns_per_ip.get(ip, 0) >= MAX_PER_IP:
+                writer.write(b"ERR refused\n")
+                await writer.drain()
+                return
+            conns_per_ip[ip] = conns_per_ip.get(ip, 0) + 1
+            counted = True
+
+            if password is not None and not await authenticate(reader, writer, password, ip):
+                print(f"x {ip} failed login")
+                return
+
+            session = random.getrandbits(32)
+            while session in players:
+                session = random.getrandbits(32)
+            print(f"+ {ip} session {session}")
+
+            last = 0.0
+            while True:
+                try:
+                    raw = await reader.readuntil(b"\n")
+                except asyncio.LimitOverrunError:
+                    break
+                if len(raw) > MAX_LINE:
+                    writer.write(b"ERR too long\n")
+                    break
+                now = time.monotonic()
+                if now - last < MIN_INTERVAL:
+                    writer.write(b"ERR slow down\n")
+                    await writer.drain()
+                    continue
+                last = now
+                reply = handle_line(session, raw.decode("ascii", "replace").strip())
+                writer.write(reply.encode("ascii") + b"\n")
+                await writer.drain()
+        except (asyncio.IncompleteReadError, ConnectionError):
+            pass
+        finally:
+            if session is not None:
+                players.pop(session, None)
+                print(f"- {ip} session {session}")
+            if counted:
+                conns_per_ip[ip] -= 1
+                if conns_per_ip[ip] <= 0:
+                    del conns_per_ip[ip]
+            writer.close()
+    return client
+
+
+def load_password(args):
+    if args.insecure_no_auth:
+        return None
+    if args.password_file:
+        with open(args.password_file, "rb") as f:
+            pw = f.read().rstrip(b"\r\n")
+    else:
+        env = os.environ.get("PSS_PASSWORD")
+        pw = env.encode("utf-8") if env else b""
+    if len(pw) < MIN_PASSWORD_LEN:
+        sys.exit(f"Set a password of at least {MIN_PASSWORD_LEN} characters in the PSS_PASSWORD "
+                 "environment variable (or use --password-file). Use --insecure-no-auth only "
+                 "for local testing.")
+    return pw
+
+
+async def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--port", type=int, default=7777)
+    ap.add_argument("--password-file", help="file whose first line is the password")
+    ap.add_argument("--insecure-no-auth", action="store_true",
+                    help="disable the password check (local testing only)")
+    args = ap.parse_args()
+    password = load_password(args)
+    server = await asyncio.start_server(make_client_handler(password), args.host, args.port,
+                                        limit=MAX_LINE * 2)
+    mode = "NO PASSWORD (insecure)" if password is None else "password required"
+    print(f"PSS relay listening on {args.host}:{args.port} - {mode}")
+    async with server:
+        await server.serve_forever()
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
